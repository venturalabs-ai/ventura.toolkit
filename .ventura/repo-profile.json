{
  "schema_version": 1,
  "repository_role": "shared_sdk",
  "autonomy": "guarded",
  "budget_profile": "normal",
  "context": {"strategy": "semantic_ast", "max_files": 20, "max_chars": 26000},
  "routing": {"enabled": true, "champion_challenger": false},
  "validation": {"required": ["sdk-tests", "autonomy-gate", "security-baseline"]},
  "security": {"hard_gates": ["delete_repository", "force_push", "change_secrets", "reduce_security", "destructive_deployment", "budget_override", "irreversible_financial_action"]}
}
